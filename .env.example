# Base de datos (en producción: cadena de conexión de Supabase, pooler en modo sesión)
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm_dev
# Base usada por los tests de integración (se migra y se limpia sola)
TEST_DATABASE_URL=postgresql://crm:crm@localhost:5432/crm_test

# Better Auth. Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
BETTER_AUTH_URL=http://localhost:3000

# Clave para cifrar campos sensibles (32 bytes en base64). Se usará desde la Fase 2.
FIELD_ENCRYPTION_KEY=

# Contraseña de los usuarios DEMO creados por el seed (solo desarrollo)
DEMO_PASSWORD=Demo-2026!
