# Base de datos (en producción: cadena de conexión de Supabase, pooler en modo sesión)
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm_dev
# Base usada por los tests de integración (se migra y se limpia sola)
TEST_DATABASE_URL=postgresql://crm:crm@localhost:5432/crm_test

# Better Auth. Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
BETTER_AUTH_URL=http://localhost:3000

# Clave para cifrar campos sensibles como cuentas bancarias (32 bytes en base64).
# Generar con: openssl rand -base64 32. Si se pierde, los datos cifrados no se recuperan.
FIELD_ENCRYPTION_KEY=

# Archivos (fotos, planos, documentos). Nunca son públicos: se sirven por rutas que verifican
# sesión y permisos. En desarrollo, disco local (carpeta .storage en la raíz del repo).
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=/ruta/absoluta/opcional
# `next start` corre en modo producción: el disco local solo se acepta con esta variable.
STORAGE_ALLOW_LOCAL=1
# En producción: STORAGE_DRIVER=s3 con cualquier servicio compatible (AWS S3, Cloudflare R2,
# Supabase Storage vía S3). Bucket privado.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Contraseña de los usuarios DEMO creados por el seed (solo desarrollo)
DEMO_PASSWORD=Demo-2026!
